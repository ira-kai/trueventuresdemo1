# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=          # for sequence + reply-classification generation
INSTANTLY_API_KEY=          # export sequences / pull reply data
EMAIL_VERIFY_API_KEY=       # e.g. ZeroBounce / NeverBounce
APOLLO_API_KEY=             # phase: later

# Vercel KV (optional in dev; required for persistence in prod)
KV_REST_API_URL=
KV_REST_API_TOKEN=
